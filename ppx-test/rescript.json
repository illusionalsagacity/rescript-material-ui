{
  "name": "dev_tests",
  "sources": ["src"],
  "uncurried": true,
  "jsx": { "version": 4, "mode": "automatic" },
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.mjs",
  "ppx-flags": [
    [
      "@illusionalsagacity/rescript-material-ui-ppx/_build/default/src/Bin.exe",
      "-importPath @mui/styles/makeStyles",
      "-importName default"
    ]
  ],
  "bs-dependencies": [
    "@rescript/react",
    "@rescript-mui/material",
    "@rescript-mui/lab"
  ],
  "warnings": {
    "number": "+A-48-30-42-40",
    "error": "+A"
  }
}
